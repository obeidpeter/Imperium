{
  "name": "imperium",
  "version": "0.35.0",
  "private": true,
  "type": "module",
  "description": "A complete twelve-chapter Roman tactical chronicle for the browser.",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs dist",
    "pretest": "node scripts/prepare-tests.mjs",
    "test": "node --test tests/*.test.mjs",
    "autoplay": "node scripts/autoplay.mjs",
    "verify": "npm test && npm run autoplay && npm run autoplay:expanded && npm run autoplay:command && npm run autoplay:production && npm run build && node scripts/verify-assets.mjs && npm run audit:characters && npm run audit:production",
    "audit:characters": "node scripts/audit-character-assets.mjs",
    "autoplay:expanded": "node scripts/expanded-autoplay.mjs",
    "smoke": "node scripts/browser-smoke.mjs",
    "autoplay:command": "node scripts/command-autoplay.mjs",
    "audit:production": "node scripts/build-character-performance.mjs --check && node scripts/audit-character-production.mjs",
    "benchmark": "node scripts/benchmark-campaign.mjs",
    "autoplay:production": "node scripts/production-autoplay.mjs",
    "art:handoff": "node scripts/build-character-handoff.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
