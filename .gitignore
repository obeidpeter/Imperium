node_modules/
dist/
dist-desktop/
.DS_Store
*.log
.env
.env.*
coverage/
tests/fixtures/
tests/visual-baselines/
tests/visual-results/

# Raw generator downloads (for example Tripo GLBs): provenance, digests and
# processed models are committed; the raw files stay local. docs/asset-pipeline.md
art-source/models/raw/
# In-progress Tripo request locks and atomic-write scratch files.
art-source/models/requests/*.json.tripo.lock
art-source/models/requests/*.json.*.tmp
# CC0 downloads: the records in art-source/cc0/ keep their sources and digests.
art-source/cc0/raw/
# Panorama renders: their reports (seed, settings, digest) reproduce them.
art-source/panoramas/*.png
# The asset pipeline's development tools (scripts/assets/setup-tools.mjs).
.tools/
# Python's bytecode cache: the Blender builders import kitlib.py beside them.
__pycache__/
# Local validation snapshots and logs; reviewed evidence belongs in docs/.
work/command-camp-refinement/
work/save-world-art/
dist-demo/

# Recoverable Steam captures: never stage unfinished image/evidence pairs.
desktop/steam/screenshots/*.pending
desktop/steam/screenshots/*.tmp
docs/evidence/steam-screenshots.json.pending
docs/evidence/steam-screenshots.json.lock
docs/evidence/steam-screenshots.json.*.tmp
desktop/steam/trailer/*.pending
desktop/steam/trailer/*.tmp
docs/evidence/steam-trailer.json.pending
docs/evidence/steam-trailer.json.lock
docs/evidence/steam-trailer.json.*.tmp
