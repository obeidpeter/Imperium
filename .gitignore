node_modules/
dist/
.DS_Store
*.log
.env
.env.*
coverage/
tests/fixtures/
tests/visual-baselines/
tests/visual-results/

# Raw generator downloads (for example Tripo GLBs): provenance, digests and
# processed models are committed; the raw files stay local. docs/asset-pipeline.md
art-source/models/raw/
# CC0 downloads: the records in art-source/cc0/ keep their sources and digests.
art-source/cc0/raw/
# Panorama renders: their reports (seed, settings, digest) reproduce them.
art-source/panoramas/*.png
# The asset pipeline's development tools (scripts/assets/setup-tools.mjs).
.tools/
# Python's bytecode cache: the Blender builders import kitlib.py beside them.
__pycache__/
